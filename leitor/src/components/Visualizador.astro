<div class="visualizador" id="visualizador" hidden>
  <div class="visualizador-barra">
    <span class="legenda" id="vis-legenda"></span>
    <span id="vis-contador"></span>
    <span>Roda do mouse: zoom · arrastar: mover · duplo clique: 250%</span>
    <button class="botao-icone" id="vis-fechar" title="Fechar (Esc)">Fechar ✕</button>
  </div>
  <button class="botao-icone visualizador-seta anterior" id="vis-anterior" title="Anterior (←)">‹</button>
  <button class="botao-icone visualizador-seta proxima" id="vis-proxima" title="Próxima (→)">›</button>
  <div class="visualizador-palco" id="vis-palco">
    <img id="vis-imagem" alt="" />
  </div>
</div>

<script>
  const raiz = document.getElementById('visualizador')!;
  const palco = document.getElementById('vis-palco')!;
  const imagem = document.getElementById('vis-imagem') as HTMLImageElement;
  const legenda = document.getElementById('vis-legenda')!;
  const contador = document.getElementById('vis-contador')!;
  const anterior = document.getElementById('vis-anterior')!;
  const proxima = document.getElementById('vis-proxima')!;

  let lista: HTMLImageElement[] = [];
  let indice = 0;
  let escala = 1;
  let x = 0;
  let y = 0;
  let arrasto: { px: number; py: number; x: number; y: number; moveu: boolean } | null = null;

  const aplicar = () => {
    imagem.style.transform = `translate(${x}px, ${y}px) scale(${escala})`;
  };

  const zoomEm = (nova: number, cx: number, cy: number) => {
    nova = Math.min(8, Math.max(1, nova));
    const r = palco.getBoundingClientRect();
    const dx = cx - (r.left + r.width / 2);
    const dy = cy - (r.top + r.height / 2);
    const k = nova / escala;
    x = dx - (dx - x) * k;
    y = dy - (dy - y) * k;
    escala = nova;
    if (escala === 1) x = y = 0;
    aplicar();
  };

  const mostrar = () => {
    const el = lista[indice];
    escala = 1;
    x = y = 0;
    aplicar();
    imagem.src = el.dataset.zoom!;
    imagem.alt = el.alt;
    legenda.textContent = el.dataset.legenda || el.alt || '';
    contador.textContent = lista.length > 1 ? `${indice + 1} / ${lista.length}` : '';
    anterior.hidden = proxima.hidden = lista.length < 2;
  };

  const abrir = (el: HTMLImageElement) => {
    const galeria = el.closest('[data-galeria]');
    lista = [...(galeria ?? document).querySelectorAll<HTMLImageElement>('img[data-zoom]')];
    indice = Math.max(0, lista.indexOf(el));
    mostrar();
    raiz.hidden = false;
    document.body.classList.add('sem-rolagem');
  };

  const fechar = () => {
    raiz.hidden = true;
    imagem.removeAttribute('src');
    document.body.classList.remove('sem-rolagem');
  };

  const passo = (d: number) => {
    if (lista.length < 2) return;
    indice = (indice + d + lista.length) % lista.length;
    mostrar();
  };

  document.addEventListener('click', (e) => {
    const alvo = (e.target as HTMLElement).closest<HTMLImageElement>('img[data-zoom]');
    if (alvo && !raiz.contains(alvo)) {
      e.preventDefault();
      abrir(alvo);
    }
  });

  document.getElementById('vis-fechar')!.addEventListener('click', fechar);
  anterior.addEventListener('click', () => passo(-1));
  proxima.addEventListener('click', () => passo(1));

  palco.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      zoomEm(escala * (e.deltaY < 0 ? 1.2 : 1 / 1.2), e.clientX, e.clientY);
    },
    { passive: false },
  );

  palco.addEventListener('pointerdown', (e) => {
    arrasto = { px: e.clientX, py: e.clientY, x, y, moveu: false };
    palco.setPointerCapture(e.pointerId);
  });

  palco.addEventListener('pointermove', (e) => {
    if (!arrasto) return;
    const dx = e.clientX - arrasto.px;
    const dy = e.clientY - arrasto.py;
    if (Math.abs(dx) + Math.abs(dy) > 4) arrasto.moveu = true;
    if (arrasto.moveu && escala > 1) {
      raiz.classList.add('arrastando');
      x = arrasto.x + dx;
      y = arrasto.y + dy;
      aplicar();
    }
  });

  palco.addEventListener('pointerup', (e) => {
    const clique = arrasto && !arrasto.moveu;
    arrasto = null;
    raiz.classList.remove('arrastando');
    if (clique && e.target === palco) fechar();
  });

  palco.addEventListener('dblclick', (e) => {
    zoomEm(escala > 1 ? 1 : 2.5, e.clientX, e.clientY);
  });

  document.addEventListener('keydown', (e) => {
    if (raiz.hidden) return;
    const acoes: Record<string, () => void> = {
      Escape: fechar,
      ArrowLeft: () => passo(-1),
      ArrowRight: () => passo(1),
      '+': () => zoomEm(escala * 1.4, innerWidth / 2, innerHeight / 2),
      '=': () => zoomEm(escala * 1.4, innerWidth / 2, innerHeight / 2),
      '-': () => zoomEm(escala / 1.4, innerWidth / 2, innerHeight / 2),
      '0': () => zoomEm(1, innerWidth / 2, innerHeight / 2),
    };
    const acao = acoes[e.key];
    if (acao) {
      e.preventDefault();
      e.stopImmediatePropagation();
      acao();
    }
  });
</script>
